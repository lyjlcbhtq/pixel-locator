# 统一换行符，避免跨平台（Windows CRLF / Linux LF）产生无意义的 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.onnx binary

# 明确文本类型
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf
